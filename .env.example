# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (same values as the admin app: that is what links the two) ----
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / "publishable" key. Safe in the browser. Used only for live updates.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key. SERVER ONLY. Never put NEXT_PUBLIC_ in front of it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters, different from the admin app's. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Shop name shown on the website
NEXT_PUBLIC_STORE_NAME=GameVault

# Set to 1 when deployed on Vercel or behind a proxy you control (used for rate limiting by IP).
TRUST_PROXY=0

# Only if the site is reachable under more than one domain (comma separated, with https://).
# ALLOWED_ORIGINS=

# Test "npm start" over plain http on a LAN only:
# COOKIE_SECURE=0

# ---- Reminders and email (optional) ----
# Secret for /api/cron/notify. Vercel sends it automatically as a Bearer token when set in project env vars.
# CRON_SECRET=
# Emails through Resend. Leave blank to use the in-app bell only.
# RESEND_API_KEY=
# MAIL_FROM=GameVault <orders@yourdomain.com>
